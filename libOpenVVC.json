{
    "name": "libOpenVVC",
    "description": "VVC video decoder",
    "filters":["vvcdec"],
    "help": "This filter decodes VVC (H.266) video elementary streams using VVdeC. Pairs with a container demuxer (e.g. isobmff) providing framed access units and a VVCC decoder config.",
    "support": [
        "video"
    ],
    "sources":"https://bevara.ddns.net/sources/libOpenVVC.accessor",
    "filter_source":{
        "vvcdec" : "dec_vvc.c"
    },
    "Format": ["VVC"],
    "using": ["solver_1"],
    "runtime": {
        "vvcdec": {
            "outputs": [
                {
                    "property": "GF_PROP_PID_PIXFMT",
                    "format": [
                        "GF_PIXEL_GREYSCALE",
                        "GF_PIXEL_YUV_10",
                        "GF_PIXEL_YUV",
                        "GF_PIXEL_YUV422_10",
                        "GF_PIXEL_YUV422",
                        "GF_PIXEL_YUV444_10",
                        "GF_PIXEL_YUV444"
                    ]
                }
            ]
        }
    },
    "patents": {
        "status": "licence-required",
        "note": "VVC (H.266): Access Advance, Via LA",
        "checked": "2026-10-16"
    }
}
